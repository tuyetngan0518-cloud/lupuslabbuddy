{
  // Settings for the Cloudflare Worker (the small server that runs the app).
  "name": "lupus-lab-buddy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",

  // The web pages in /public are served as-is. Anything under /api/ goes to the Worker code first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The AI models and the search index. Both run on Cloudflare even during local testing.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "lupus-chunks", "remote": true }]
}
